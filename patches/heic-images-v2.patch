+import { describe, expect, test } from "bun:test"
+import { createRoot } from "solid-js"
+import {
+  attachmentMime,
+  convertHeicToJpeg,
+  createPromptInputV2Attachments,
+  isHeicFile,
+  setHeicConverterForTests,
+} from "./attachments"
+
+describe("v2 attachmentMime", () => {
+  test("keeps HEIC when the browser reports the mime", async () => {
+    const file = new File(["heic"], "photo.heic", { type: "image/heic" })
+    expect(await attachmentMime(file)).toBe("image/heic")
+  })
+
+  test("keeps HEIF when the browser reports the mime", async () => {
+    const file = new File(["heif"], "photo.heif", { type: "image/heif" })
+    expect(await attachmentMime(file)).toBe("image/heif")
+  })
+
+  test("falls back to HEIC for .heic files with an unknown browser mime", async () => {
+    const file = new File(["heic"], "IMG_1234.HEIC", { type: "application/octet-stream" })
+    expect(await attachmentMime(file)).toBe("image/heic")
+  })
+})
+
+describe("v2 heic attachments", () => {
+  test("detects HEIC files by mime or extension", () => {
+    expect(isHeicFile(new File(["a"], "photo.heic", { type: "image/heic" }))).toBe(true)
+    expect(isHeicFile(new File(["a"], "photo.heif", { type: "image/heif" }))).toBe(true)
+    expect(isHeicFile(new File(["a"], "IMG_1234.HEIC", { type: "" }))).toBe(true)
+    expect(isHeicFile(new File(["a"], "live.heic", { type: "image/heic-sequence" }))).toBe(true)
+    expect(isHeicFile(new File(["a"], "photo.png", { type: "image/png" }))).toBe(false)
+  })
+
+  test("converts HEIC to a JPEG file with a .jpg name", async () => {
+    setHeicConverterForTests(async () => new Blob(["jpeg"], { type: "image/jpeg" }))
+    try {
+      const converted = await convertHeicToJpeg(new File(["heic"], "photo.heic", { type: "image/heic" }))
+      expect(converted.type).toBe("image/jpeg")
+      expect(converted.name).toBe("photo.jpg")
+    } finally {
+      setHeicConverterForTests(undefined)
+    }
+  })
+
+  test("uses the first frame of multi-image HEIC containers", async () => {
+    setHeicConverterForTests(async () => [
+      new Blob(["first"], { type: "image/jpeg" }),
+      new Blob(["second"], { type: "image/jpeg" }),
+    ])
+    try {
+      const converted = await convertHeicToJpeg(new File(["heic"], "burst.heic", { type: "image/heic" }))
+      expect(await converted.text()).toBe("first")
+    } finally {
+      setHeicConverterForTests(undefined)
+    }
+  })
+
+  test("attaching a HEIC photo converts it before storing", async () => {
+    setHeicConverterForTests(async () => new Blob(["jpeg"], { type: "image/jpeg" }))
+    try {
+      const seen: { filename: string; mime: string }[] = []
+      let warned = 0
+      const ok = await createRoot(() =>
+        createPromptInputV2Attachments({
+          capture: () => ({
+            current: () => [],
+            cursor: () => 0,
+            set: (parts) => {
+              for (const part of parts) {
+                if (part.type === "image") seen.push({ filename: part.filename, mime: part.mime })
+              }
+            },
+          }),
+          editor: () => ({} as HTMLElement),
+          focusEditor: () => undefined,
+          addPart: () => false,
+          setDraggingType: () => undefined,
+          directory: () => "/tmp",
+          isDialogActive: () => false,
+          warn: () => {
+            warned += 1
+          },
+          duplicate: () => undefined,
+          onError: () => undefined,
+          store: async () => ({ id: "blob", url: "blob:jpeg" }),
+        }).addAttachments([new File(["heic"], "photo.heic", { type: "image/heic" })]),
+      )
+      expect(ok).toBe(true)
+      expect(warned).toBe(0)
+      expect(seen).toEqual([{ filename: "photo.jpg", mime: "image/jpeg" }])
+    } finally {
+      setHeicConverterForTests(undefined)
+    }
+  })
+
+  test("attaching an undecodable HEIC warns instead of crashing", async () => {
+    setHeicConverterForTests(async () => Promise.reject(new Error("unsupported variant")))
+    try {
+      let warned = 0
+      const ok = await createRoot(() =>
+        createPromptInputV2Attachments({
+          capture: () => ({
+            current: () => [],
+            cursor: () => 0,
+            set: () => undefined,
+          }),
+          editor: () => ({} as HTMLElement),
+          focusEditor: () => undefined,
+          addPart: () => false,
+          setDraggingType: () => undefined,
+          directory: () => "/tmp",
+          isDialogActive: () => false,
+          warn: () => {
+            warned += 1
+          },
+          duplicate: () => undefined,
+          onError: () => undefined,
+          store: async () => ({ id: "blob", url: "blob:jpeg" }),
+        }).addAttachments([new File(["heic"], "photo.heic", { type: "image/heic" })]),
+      )
+      expect(ok).toBe(false)
+      expect(warned).toBe(1)
+    } finally {
+      setHeicConverterForTests(undefined)
+    }
+  })
+})
