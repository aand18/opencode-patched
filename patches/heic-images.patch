+export function isHeicFile(file: File) {
+  if (HEIC_MIMES.has(kind(file.type))) return true
+  const suffix = ext(file.name)
+  return suffix === "heic" || suffix === "heif"
+}
+
+export type HeicConverter = (input: { blob: Blob }) => Promise<Blob | Blob[]>
+
+let heicConverter: HeicConverter | undefined
+
+export function setHeicConverterForTests(converter: HeicConverter | undefined) {
+  heicConverter = converter
+}
+
+async function defaultHeicConverter(input: { blob: Blob }) {
+  // Browser-only: heic2any touches window/Worker at import time, so this
+  // must stay a lazy import on the attach path, never a static import.
+  const { default: heic2any } = await import("heic2any")
+  return heic2any({ blob: input.blob, toType: "image/jpeg", quality: 0.92 })
+}
+
+export async function convertHeicToJpeg(file: File) {
+  const convert = heicConverter ?? defaultHeicConverter
+  const result = await convert({ blob: file })
+  const blob = Array.isArray(result) ? result[0] : result
+  if (!blob) throw new Error("HEIC conversion produced no images")
+  const base = file.name.includes(".") ? file.name.slice(0, file.name.lastIndexOf(".")) : file.name
+  return new File([blob], `${base || "photo"}.jpg`, { type: "image/jpeg" })
+}
