+import { Effect } from "effect"
+import { PluginInfo } from "@/plugin/info"
+import * as InstanceState from "@/effect/instance-state"
+import { HttpApiBuilder } from "effect/unstable/httpapi"
+import { InstanceHttpApi } from "../api"
+import { markInstanceForDisposal } from "../lifecycle"
+import { PluginApiError } from "../groups/plugin"
+
+export const pluginHandlers = HttpApiBuilder.group(InstanceHttpApi, "plugin", (handlers) =>
+  Effect.gen(function* () {
+    const pluginSvc = yield* PluginInfo.Service
+
+    const get = Effect.fn("PluginHttpApi.get")(function* () {
+      return yield* pluginSvc.list()
+    })
+
+    const update = Effect.fn("PluginHttpApi.update")(function* (ctx) {
+      const item = yield* pluginSvc.update(ctx.payload).pipe(
+        Effect.mapError(
+          (error) =>
+            new PluginApiError({
+              name: "PluginUpdateError",
+              data: { message: error.message },
+            }),
+        ),
+      )
+      yield* markInstanceForDisposal(yield* InstanceState.context)
+      return item
+    })
+
+    return handlers.handle("get", get).handle("update", update)
+  }),
+)
