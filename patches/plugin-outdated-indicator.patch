+describe("classify", () => {
+  test("bare npm package", () => {
+    expect(classify("acme")).toEqual({
+      kind: "npm",
+      name: "acme",
+      url: "https://www.npmjs.com/package/acme",
+      committish: null,
+    })
+  })
+
+  test("npm package with version", () => {
+    expect(classify("acme@1.0.0")).toEqual({
+      kind: "npm",
+      name: "acme",
+      url: "https://www.npmjs.com/package/acme",
+      committish: null,
+    })
+  })
+
+  test("scoped npm package", () => {
+    expect(classify("@opencode/acme@1.0.0").name).toBe("@opencode/acme")
+    expect(classify("@opencode/acme@1.0.0").url).toBe("https://www.npmjs.com/package/@opencode/acme")
+  })
+
+  test("git https url", () => {
+    expect(classify("git+https://github.com/user/repo")).toEqual({
+      kind: "git",
+      name: "repo",
+      url: "https://github.com/user/repo",
+      committish: null,
+    })
+  })
+
+  test("git https url with committish", () => {
+    expect(classify("git+https://github.com/user/repo#v1.0.0")).toEqual({
+      kind: "git",
+      name: "repo",
+      url: "https://github.com/user/repo",
+      committish: "v1.0.0",
+    })
+  })
+
+  test("git ssh url with committish", () => {
+    expect(classify("git+ssh://git@github.com/user/repo.git#main")).toEqual({
+      kind: "git",
+      name: "repo",
+      url: "ssh://git@github.com/user/repo",
+      committish: "main",
+    })
+  })
+
+  test("hosted git shorthand", () => {
+    expect(classify("user/repo")).toEqual({
+      kind: "git",
+      name: "repo",
+      url: "https://github.com/user/repo",
+      committish: null,
+    })
+  })
+
+  test("scoped npm name wins over git url", () => {
+    expect(classify("@scope/a@git+https://github.com/u/r.git").name).toBe("@scope/a")
+  })
+
+  test("relative path", () => {
+    const cls = classify("./local")
+    expect(cls.kind).toBe("path")
+    expect(cls.name).toBe("local")
+    expect(cls.url).toBeNull()
+  })
+
+  test("file url path", () => {
+    const cls = classify("file:///tmp/x")
+    expect(cls.kind).toBe("path")
+    expect(cls.name).toBe("x")
+  })
+})
+
+describe("updateSpec", () => {
+  test("npm package gets versioned", () => {
+    expect(updateSpec("acme", "1.2.3")).toBe("acme@1.2.3")
+  })
+
+  test("npm package replaces existing version", () => {
+    expect(updateSpec("acme@1.0.0", "2.0.0")).toBe("acme@2.0.0")
+  })
+
+  test("scoped npm package", () => {
+    expect(updateSpec("@opencode/acme@1.0.0", "2.0.0")).toBe("@opencode/acme@2.0.0")
+  })
+
+  test("git url gains committish", () => {
+    expect(updateSpec("git+https://github.com/user/repo", "v2.0.0")).toBe(
+      "git+https://github.com/user/repo#v2.0.0",
+    )
+  })
+
+  test("git url replaces existing committish", () => {
