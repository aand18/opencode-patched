+    const oldCache = path.join(tmp.path, "packages", "acme@1.0.0")
+    await fs.mkdir(oldCache, { recursive: true })
+    await fs.writeFile(cfgFile, JSON.stringify({ plugin: ["acme@1.0.0"] }))
+    const { deps, counters } = makeDeps({
+      dir: tmp.path,
+      config: { plugin: ["acme@1.0.0"], plugin_origins: [{ spec: "acme@1.0.0", source: cfgFile }] },
+      npm: { "dist-tags": { latest: "2.0.0" }, versions: { "1.0.0": {}, "2.0.0": {} } },
+    })
+    const item = await Effect.runPromise(makeService(deps).update({ spec: "acme@1.0.0", version: "2.0.0" }))
+    expect(JSON.parse(await fs.readFile(cfgFile, "utf8"))).toEqual({ plugin: ["acme@2.0.0"] })
+    let cacheGone = false
+    try {
+      await fs.stat(oldCache)
+    } catch {
+      cacheGone = true
+    }
+    expect(cacheGone).toBe(true)
+    expect(counters.invalidate).toBe(1)
