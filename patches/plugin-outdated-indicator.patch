+  })
+
+  test("rejects path plugins", async () => {
+    await using tmp = await tmpdir()
+    const cfgFile = path.join(tmp.path, "config.json")
+    await fs.writeFile(cfgFile, JSON.stringify({ plugin: ["./local"] }))
+    const { deps } = makeDeps({
+      dir: tmp.path,
+      config: { plugin: ["./local"], plugin_origins: [{ spec: "./local", source: cfgFile }] },
+    })
+    await expect(
+      Effect.runPromise(makeService(deps).update({ spec: "./local", version: "2.0.0" })),
+    ).rejects.toMatchObject({ _tag: "PluginUpdateError" })
+  })
+
+  test("rejects a spec that is not in the config", async () => {
+    await using tmp = await tmpdir()
+    const { deps } = makeDeps({
+      dir: tmp.path,
+      config: { plugin: [], plugin_origins: [] },
+      npm: { versions: { "1.0.0": {} } },
+    })
+    await expect(
+      Effect.runPromise(makeService(deps).update({ spec: "acme@1.0.0", version: "1.0.0" })),
+    ).rejects.toMatchObject({ _tag: "PluginUpdateError" })
+  })
+})
