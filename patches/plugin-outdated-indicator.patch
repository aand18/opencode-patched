+describe("isOutdated", () => {
+  test("true when installed < latest", () => {
+    expect(isOutdated("1.0.0", "2.0.0")).toBe(true)
+  })
+
+  test("false when installed >= latest", () => {
+    expect(isOutdated("2.0.0", "2.0.0")).toBe(false)
+    expect(isOutdated("3.0.0", "2.0.0")).toBe(false)
+  })
+
+  test("null when either side is missing or unparseable", () => {
+    expect(isOutdated(null, "2.0.0")).toBeNull()
+    expect(isOutdated("1.0.0", null)).toBeNull()
+    expect(isOutdated(undefined, "2.0.0")).toBeNull()
+    expect(isOutdated("not-a-version", "2.0.0")).toBeNull()
+  })
+})
+
+describe("rewritePluginSpec", () => {
+  test("replaces a bare entry, preserving the rest", () => {
+    const next = rewritePluginSpec('{ "plugin": ["acme", "other@1.0.0"] }', "acme", "acme@1.2.3")
+    expect(next).toBeDefined()
+    expect(JSON.parse(next!)).toEqual({ plugin: ["acme@1.2.3", "other@1.0.0"] })
+  })
+
+  test("replaces only the specifier of an entry with options", () => {
+    const next = rewritePluginSpec(
+      '{ "plugin": [["acme", { "enabled": true }]] }',
+      "acme",
+      "acme@1.2.3",
+    )
+    expect(next).toBeDefined()
+    expect(JSON.parse(next!)).toEqual({ plugin: [["acme@1.2.3", { enabled: true }]] })
+  })
+
+  test("returns undefined when the plugin is not present", () => {
+    expect(rewritePluginSpec('{ "plugin": ["other@1.0.0"] }', "acme", "acme@1.2.3")).toBeUndefined()
+  })
+
+  test("returns undefined when there is no plugin array", () => {
+    expect(rewritePluginSpec('{ "model": "acme" }', "acme", "acme@1.2.3")).toBeUndefined()
+  })
+})
+
+const json = (request: Parameters<typeof HttpClientResponse.fromWeb>[0], body: unknown, status = 200) =>
+  HttpClientResponse.fromWeb(request, new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } }))
+
+type Counters = {
+  gitLsRemote: number
+  gitRevParse: number
+  http: number
+  invalidate: number
+}
+
+function makeDeps(input: {
+  dir: string
+  config: { plugin: unknown[]; plugin_origins?: { spec: unknown; source: string }[] }
+  gitTags?: string
+  gitHead?: string
+  npm?: unknown
+  gitFail?: boolean
+  httpFail?: boolean
+}): { deps: Deps; counters: Counters } {
+  const counters: Counters = { gitLsRemote: 0, gitRevParse: 0, http: 0, invalidate: 0 }
+  const fsFake = {
+    readFileStringSafe: (file: string) =>
+      Effect.tryPromise({
+        try: async () => {
+          try {
+            return await fs.readFile(file, "utf8")
+          } catch {
+            return undefined
+          }
+        },
+        catch: (e) => e as Error,
+      }),
+    readFileString: (file: string) =>
+      Effect.tryPromise({
+        try: () => fs.readFile(file, "utf8"),
+        catch: (e) => e as Error,
+      }),
+    writeFileString: (file: string, data: string) =>
+      Effect.tryPromise({
+        try: async () => {
+          await fs.mkdir(path.dirname(file), { recursive: true })
+          await fs.writeFile(file, data, "utf8")
+        },
+        catch: (e) => e as Error,
+      }),
+    remove: (file: string) =>
+      Effect.tryPromise({
+        try: async () => {
+          await fs.rm(file, { recursive: true, force: true })
+        },
+        catch: (e) => e as Error,
+      }),
+  }
+  const spawnerFake = {
+    string: (cmd: { command: string; args: readonly string[] }) => {
+      if (cmd.command === "git" && cmd.args.includes("ls-remote")) {
+        counters.gitLsRemote++
+        if (input.gitFail) return Effect.fail(new Error("git ls-remote failed"))
+        return Effect.succeed(input.gitTags ?? "")
+      }
+      if (cmd.command === "git" && cmd.args.includes("rev-parse")) {
+        counters.gitRevParse++
+        if (input.gitHead === undefined) return Effect.fail(new Error("not a git repository"))
+        return Effect.succeed(input.gitHead)
+      }
+      return Effect.fail(new Error(`unexpected command: ${cmd.command} ${cmd.args.join(" ")}`))
+    },
+  }
+  const httpFake = HttpClient.make((request) => {
+    counters.http++
+    if (input.httpFail) return Effect.succeed(json(request, {}, 500))
+    return Effect.succeed(json(request, input.npm ?? {}))
+  })
+  const configFake = {
+    get: () => Effect.succeed(input.config),
+    invalidate: () => {
+      counters.invalidate++
+      return Effect.void
+    },
+  }
+  const globalFake = { cache: input.dir }
+  const deps: Deps = {
+    config: configFake as unknown as Config.Interface,
+    global: globalFake as unknown as Global.Interface,
+    fs: fsFake as unknown as FSUtil.Interface,
+    spawner: spawnerFake as unknown as AppProcess.Interface,
+    http: httpFake,
+    scope: Scope.makeUnsafe(),
+  }
+  return { deps, counters }
+}
+
+describe("makeService.list", () => {
+  test("returns installed, latest, outdated and versions for an npm plugin", async () => {
+    await using tmp = await tmpdir()
+    const cfgFile = path.join(tmp.path, "config.json")
+    const pkgFile = path.join(tmp.path, "packages", "acme@1.0.0", "node_modules", "acme", "package.json")
+    await fs.mkdir(path.dirname(pkgFile), { recursive: true })
+    await fs.writeFile(pkgFile, JSON.stringify({ name: "acme", version: "1.0.0" }))
+    const { deps, counters } = makeDeps({
+      dir: tmp.path,
+      config: { plugin: ["acme@1.0.0"], plugin_origins: [{ spec: "acme@1.0.0", source: cfgFile }] },
+      npm: { "dist-tags": { latest: "2.0.0" }, versions: { "1.0.0": {}, "2.0.0": {}, "2.1.0": {} } },
+    })
+    const items = await Effect.runPromise(makeService(deps).list())
+    expect(items).toEqual([
+      {
+        spec: "acme@1.0.0",
+        kind: "npm",
+        name: "acme",
+        url: "https://www.npmjs.com/package/acme",
+        installed: "1.0.0",
+        latest: "2.0.0",
+        outdated: true,
+        versions: ["2.1.0", "2.0.0", "1.0.0"],
+      },
+    ])
+    expect(counters.http).toBe(1)
+  })
+
+  test("finds a bare npm name under its name@latest cache key", async () => {
+    await using tmp = await tmpdir()
+    const pkgFile = path.join(tmp.path, "packages", "acme@latest", "node_modules", "acme", "package.json")
+    await fs.mkdir(path.dirname(pkgFile), { recursive: true })
+    await fs.writeFile(pkgFile, JSON.stringify({ name: "acme", version: "1.0.0" }))
+    const { deps } = makeDeps({
+      dir: tmp.path,
+      config: { plugin: ["acme"], plugin_origins: [{ spec: "acme", source: "/c" }] },
+      npm: { "dist-tags": { latest: "1.0.0" }, versions: { "1.0.0": {} } },
+    })
+    const items = await Effect.runPromise(makeService(deps).list())
+    expect(items[0]).toMatchObject({ spec: "acme", installed: "1.0.0", latest: "1.0.0", outdated: false })
+  })
+
+  test("caches results within the ttl", async () => {
+    await using tmp = await tmpdir()
+    const { deps, counters } = makeDeps({
+      dir: tmp.path,
+      config: { plugin: ["acme@1.0.0"], plugin_origins: [{ spec: "acme@1.0.0", source: "/c" }] },
+      npm: { "dist-tags": { latest: "2.0.0" }, versions: { "1.0.0": {}, "2.0.0": {} } },
+    })
+    const svc = makeService(deps)
+    await Effect.runPromise(svc.list())
+    await Effect.runPromise(svc.list())
+    expect(counters.http).toBe(1)
+  })
+
+  test("reads the installed git commit via rev-parse", async () => {
+    await using tmp = await tmpdir()
+    const pkgFile = path.join(
+      tmp.path,
+      "packages",
+      "acme@git+https://github.com/user/repo",
+      "node_modules",
+      "acme",
+      "package.json",
+    )
+    await fs.mkdir(path.dirname(pkgFile), { recursive: true })
+    await fs.writeFile(pkgFile, JSON.stringify({ name: "acme", version: "1.0.0" }))
