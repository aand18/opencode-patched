index 000000000..31401e0ca
--- /dev/null
+++ b/packages/opencode/src/plugin/info.ts
@@ -0,0 +1,372 @@
+import path from "path"
+import { fileURLToPath } from "url"
+import npa from "npm-package-arg"
+import semver from "semver"
+import { applyEdits, modify, parse } from "jsonc-parser"
+import { Context, Effect, Layer, Option, Scope, Schema, Types } from "effect"
+import { ChildProcess } from "effect/unstable/process"
+import { HttpClient, HttpClientRequest } from "effect/unstable/http"
+import { AppProcess } from "@opencode-ai/core/process"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+import { Global } from "@opencode-ai/core/global"
+import { Npm } from "@opencode-ai/core/npm"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { httpClient } from "@opencode-ai/core/effect/app-node-platform"
+import { serviceUse } from "@opencode-ai/core/effect/service-use"
+import { ConfigPluginV1 } from "@opencode-ai/core/v1/config/plugin"
+import { Config } from "@/config/config"
+import { ConfigPlugin } from "@/config/plugin"
+import { isPathPluginSpec } from "./shared"
+
+export type PluginKind = "git" | "npm" | "path"
+
+export type PluginClass = {
+  readonly kind: PluginKind
+  readonly name: string
+  readonly url: string | null
+  readonly committish: string | null
+}
+
+export type PluginRemote = {
+  readonly latest: string | null
+  readonly versions: string[]
+}
+
+export const PluginInfoItem = Schema.Struct({
+  spec: Schema.String,
+  kind: Schema.Literals(["git", "npm", "path"]),
+  name: Schema.String,
+  url: Schema.optional(Schema.String),
+  installed: Schema.optional(Schema.String),
+  commit: Schema.optional(Schema.String),
+  latest: Schema.optional(Schema.String),
+  outdated: Schema.optional(Schema.Boolean),
+  versions: Schema.Array(Schema.String),
+})
+export type PluginInfoItem = Types.DeepMutable<Schema.Schema.Type<typeof PluginInfoItem>>
+
+export const UpdateInput = Schema.Struct({
+  spec: Schema.String,
+  version: Schema.String,
+})
+export type UpdateInput = Types.DeepMutable<Schema.Schema.Type<typeof UpdateInput>>
+
+export class PluginUpdateError extends Schema.TaggedErrorClass<PluginUpdateError>()("PluginUpdateError", {
+  message: Schema.String,
+}) {}
+
+export interface Interface {
+  readonly list: () => Effect.Effect<PluginInfoItem[]>
+  readonly update: (
+    input: { readonly spec: string; readonly version: string },
+  ) => Effect.Effect<PluginInfoItem, PluginUpdateError>
+}
+
+export class Service extends Context.Service<Service, Interface>()("@opencode/PluginInfo") {}
+
+export const use = serviceUse(Service)
+
+export function classify(spec: string): PluginClass {
+  if (isPathPluginSpec(spec)) {
+    const raw = spec.startsWith("file://") ? fileURLToPath(spec) : spec
+    return { kind: "path", name: path.basename(raw), url: null, committish: null }
+  }
+  const fallback: PluginClass = {
+    kind: "npm",
+    name: spec,
+    url: `https://www.npmjs.com/package/${spec}`,
+    committish: null,
+  }
+  let hit: npa.Result | undefined
+  try {
+    hit = npa(spec)
+  } catch {
+    return fallback
+  }
+  const sub = hit.type === "alias" ? (hit as npa.AliasResult).subSpec : undefined
+  const inner = sub !== undefined ? sub : hit
+  if (inner.type === "git") {
+    const gitUrl =
+      inner.fetchSpec ??
+      (inner.hosted ? `https://${inner.hosted.domain}/${inner.hosted.user}/${inner.hosted.project}` : null)
+    const home = gitUrl === null ? null : gitUrl.replace(/^git\+/, "").replace(/\.git$/, "")
+    return {
+      kind: "git",
+      name: inner.name ?? (home !== null ? path.basename(home) : spec),
+      url: home,
+      committish: inner.gitCommittish ?? null,
+    }
+  }
+  const name = hit.name ?? spec
+  return { kind: "npm", name, url: `https://www.npmjs.com/package/${name}`, committish: null }
+}
+
+export function updateSpec(spec: string, version: string): string {
+  const cls = classify(spec)
+  if (cls.kind === "path") return spec
+  if (cls.kind === "git") {
+    const at = spec.lastIndexOf("#")
+    return `${at === -1 ? spec : spec.slice(0, at)}#${version}`
+  }
+  return `${cls.name}@${version}`
+}
+
+export function parseTags(output: string): PluginRemote | null {
+  const tags = new Set(
+    output
+      .split("\n")
+      .map((line) => {
+        const at = line.indexOf("\t")
+        return at === -1 ? null : line.slice(at + 1).trim()
+      })
+      .filter((ref): ref is string => ref !== null && ref.startsWith("refs/tags/"))
+      .map((ref) => ref.slice("refs/tags/".length))
+      .filter((tag) => !tag.endsWith("^{}")),
+  )
+  const ranked = [...tags]
+    .map((tag) => ({ tag, semver: semver.parse(tag) }))
+    .filter((item): item is { tag: string; semver: semver.SemVer } => item.semver !== null)
+  if (ranked.length === 0) return null
+  ranked.sort((a, b) => semver.rcompare(a.semver, b.semver))
+  const stable = ranked.find((item) => item.semver.prerelease.length === 0)
+  return {
+    latest: semver.clean(stable?.tag ?? ranked[0].tag) ?? null,
+    versions: ranked.slice(0, 10).map((item) => item.tag),
+  }
+}
+
+export function parseNpmRegistry(doc: unknown): PluginRemote | null {
+  if (typeof doc !== "object" || doc === null) return null
+  const record = doc as Record<string, unknown>
+  const distTags = record["dist-tags"]
+  const distLatest =
+    distTags !== null && typeof distTags === "object" ? (distTags as Record<string, unknown>)["latest"] : undefined
+  const latest = typeof distLatest === "string" ? distLatest : null
+  const versions = record["versions"]
+  if (versions === null || typeof versions !== "object") return null
+  const ranked = Object.keys(versions as Record<string, unknown>)
+    .map((key) => ({ key, semver: semver.parse(key) }))
+    .filter((item): item is { key: string; semver: semver.SemVer } => item.semver !== null)
+  if (ranked.length === 0) return null
+  ranked.sort((a, b) => semver.rcompare(a.semver, b.semver))
+  const stable = ranked.find((item) => item.semver.prerelease.length === 0)
+  return {
+    latest: latest ?? stable?.key ?? ranked[0].key,
+    versions: ranked.slice(0, 10).map((item) => item.key),
+  }
+}
+
+export function isOutdated(installed: string | null | undefined, latest: string | null | undefined): boolean | null {
+  if (installed === null || installed === undefined || latest === null || latest === undefined) return null
+  const a = semver.parse(installed)
+  const b = semver.parse(latest)
+  if (a === null || b === null) return null
+  return semver.lt(a, b)
+}
+
+export function rewritePluginSpec(text: string, oldSpec: string, newSpec: string): string | undefined {
+  const json = parse(text, []) as { plugin?: unknown }
+  const list = json?.plugin
+  if (!Array.isArray(list)) return undefined
+  const index = list.findIndex((item) => ConfigPlugin.pluginSpecifier(item as ConfigPluginV1.Spec) === oldSpec)
+  if (index === -1) return undefined
+  const entry = list[index]
+  const value = Array.isArray(entry) ? [newSpec, ...entry.slice(1)] : newSpec
+  return applyEdits(text, modify(text, ["plugin", index], value, { formattingOptions: { insertSpaces: true, tabSize: 2 } }))
+}
+
+export type Deps = {
+  readonly config: Config.Interface
+  readonly global: Global.Interface
+  readonly fs: FSUtil.Interface
+  readonly spawner: AppProcess.Interface
+  readonly http: HttpClient.HttpClient
+  readonly scope: Scope.Scope
+}
+
+const TTL = 15 * 60 * 1000
+const REMOTE_TIMEOUT = 10_000
+
+// Matches the install cache key derivation in resolvePluginTarget (shared.ts):
+// bare npm names are cached under `name@latest`, everything else under the raw spec.
+function cacheKey(spec: string): string {
+  let hit: npa.Result | undefined
+  try {
+    hit = npa(spec)
+  } catch {
+    return spec
+  }
+  return hit?.name && hit.raw === hit.name ? `${hit.name}@latest` : spec
+}
+
+export function makeService(deps: Deps): Interface {
+  const cache = new Map<string, { at: number; item: PluginInfoItem }>()
+
+  const packageJsonCandidates = (spec: string, cls: PluginClass): string[] => {
+    if (cls.kind === "path") {
+      const raw = spec.startsWith("file://") ? fileURLToPath(spec) : spec
+      return [path.join(raw, "package.json"), path.join(path.dirname(raw), "package.json")]
+    }
+    const base = path.join(deps.global.cache, "packages", Npm.sanitize(cacheKey(spec)))
+    return [path.join(base, "node_modules", cls.name, "package.json"), path.join(base, "package.json")]
+  }
+
+  const readPackageJson = Effect.fnUntraced(function* (file: string) {
+    const text = yield* deps.fs.readFileStringSafe(file).pipe(Effect.catch(() => Effect.succeed(undefined)))
+    if (text === undefined) return undefined
+    const doc = Schema.decodeUnknownOption(Schema.UnknownFromJsonString)(text)
+    if (Option.isNone(doc)) return undefined
+    return doc.value as Record<string, unknown>
+  })
+
+  const readInstalled = Effect.fn("PluginInfo.readInstalled")(function* (spec: string, cls: PluginClass) {
+    const candidates = packageJsonCandidates(spec, cls)
+    const parsed = yield* Effect.all(candidates.map(readPackageJson))
+    const index = parsed.findIndex((value) => value !== undefined)
+    const json = index === -1 ? undefined : parsed[index]
+    const pkgDir = index === -1 ? undefined : path.dirname(candidates[index])
+    const version = json !== undefined && typeof json["version"] === "string" ? json["version"] : undefined
+    const name = json !== undefined && typeof json["name"] === "string" ? json["name"] : undefined
+    const commit =
+      cls.kind === "git" && pkgDir !== undefined
+        ? yield* deps.spawner
+            .string(ChildProcess.make("git", ["-C", pkgDir, "rev-parse", "--short", "HEAD"]))
+            .pipe(
+              Effect.map((out) => out.trim()),
+              Effect.catch(() => Effect.succeed(undefined)),
+            )
+        : undefined
+    return { name, version, commit }
+  })
+
+  const fetchRemote = Effect.fn("PluginInfo.fetchRemote")(function* (cls: PluginClass) {
+    if (cls.kind === "path") return null
+    if (cls.kind === "git") {
+      const url = cls.url
+      if (url === null) return null
+      const out = yield* deps.spawner.string(ChildProcess.make("git", ["ls-remote", "--tags", url]))
+      return parseTags(out)
+    }
+    const response = yield* HttpClient.filterStatusOk(deps.http).execute(
+      HttpClientRequest.get(`https://registry.npmjs.org/${cls.name}`).pipe(HttpClientRequest.acceptJson),
+    )
+    const doc = yield* Schema.decodeUnknownEffect(Schema.UnknownFromJsonString)(yield* response.text)
+    return parseNpmRegistry(doc)
+  })
+
+  const build = Effect.fn("PluginInfo.build")(function* (spec: string, cls: PluginClass) {
+    const pair = yield* Effect.all(
+      [
+        readInstalled(spec, cls),
+        fetchRemote(cls).pipe(Effect.timeout(REMOTE_TIMEOUT), Effect.catch(() => Effect.succeed(null))),
+      ] as const,
+    )
+    const installed = pair[0]
+    const remote = pair[1]
+    const latest = remote?.latest ?? null
+    const outdated = isOutdated(installed.version, latest)
+    return {
+      spec,
+      kind: cls.kind,
+      name: installed.name ?? cls.name,
+      ...(cls.url !== null ? { url: cls.url } : {}),
+      ...(installed.version !== undefined ? { installed: installed.version } : {}),
+      ...(installed.commit !== undefined ? { commit: installed.commit } : {}),
+      ...(latest !== null ? { latest } : {}),
+      ...(outdated !== null ? { outdated } : {}),
+      versions: remote?.versions ?? [],
+    }
+  })
+
+  const one = Effect.fn("PluginInfo.one")(function* (spec: string) {
+    const cls = classify(spec)
+    const hit = cache.get(spec)
+    if (hit !== undefined && Date.now() - hit.at < TTL) return hit.item
+    if (hit !== undefined) {
+      yield* build(spec, cls).pipe(
+        Effect.tap((item) => Effect.sync(() => cache.set(spec, { at: Date.now(), item }))),
+        Effect.ignore,
+        Effect.forkIn(deps.scope),
+      )
+      return hit.item
+    }
+    const item = yield* build(spec, cls)
+    yield* Effect.sync(() => cache.set(spec, { at: Date.now(), item }))
+    return item
+  })
+
+  const list = Effect.fn("PluginInfo.list")(function* () {
+    const info = yield* deps.config.get()
+    const specs = (info.plugin ?? []).map(ConfigPlugin.pluginSpecifier)
+    return yield* Effect.all(specs.map((spec) => one(spec)), { concurrency: 8 })
+  })
+
+  const rewritePluginEntry = Effect.fn("PluginInfo.rewritePluginEntry")(function* (
+    file: string,
+    oldSpec: string,
+    newSpec: string,
+  ) {
+    const text = yield* deps.fs.readFileString(file).pipe(
+      Effect.mapError(() => new PluginUpdateError({ message: `cannot read config file: ${file}` })),
+    )
+    const next = rewritePluginSpec(text, oldSpec, newSpec)
+    if (next === undefined) return yield* new PluginUpdateError({ message: `plugin not found in config file: ${file}` })
+    yield* deps.fs.writeFileString(file, next).pipe(
+      Effect.mapError(() => new PluginUpdateError({ message: `cannot write config file: ${file}` })),
+    )
+  })
+
+  const update = Effect.fn("PluginInfo.update")(function* (
+    input: { readonly spec: string; readonly version: string },
+  ) {
+    const info = yield* deps.config.get()
+    const origin = (info.plugin_origins ?? []).find(
+      (item) => ConfigPlugin.pluginSpecifier(item.spec) === input.spec,
+    )
+    if (origin === undefined) return yield* new PluginUpdateError({ message: `plugin not found in config: ${input.spec}` })
+    const cls = classify(input.spec)
+    if (cls.kind === "path")
+      return yield* new PluginUpdateError({ message: `path plugins cannot be updated: ${input.spec}` })
+    const remote = yield* fetchRemote(cls).pipe(
+      Effect.timeout(REMOTE_TIMEOUT),
+      Effect.mapError(() => new PluginUpdateError({ message: `could not determine available versions for ${input.spec}` })),
+    )
+    if (remote === null)
+      return yield* new PluginUpdateError({ message: `could not determine available versions for ${input.spec}` })
+    if (!remote.versions.includes(input.version))
+      return yield* new PluginUpdateError({ message: `version not available for ${input.spec}: ${input.version}` })
+    const nextSpec = updateSpec(input.spec, input.version)
+    if (nextSpec !== input.spec) {
+      yield* rewritePluginEntry(origin.source, input.spec, nextSpec)
+      yield* deps.fs.remove(path.join(deps.global.cache, "packages", Npm.sanitize(cacheKey(input.spec)))).pipe(
+        Effect.catch(() => Effect.void),
+      )
+    }
+    yield* Effect.sync(() => cache.delete(input.spec))
+    yield* deps.config.invalidate()
+    return yield* build(nextSpec, classify(nextSpec))
+  })
+
+  return { list, update }
+}
+
+const layer = Layer.effect(
+  Service,
+  Effect.gen(function* () {
+    const config = yield* Config.Service
+    const global = yield* Global.Service
+    const fs = yield* FSUtil.Service
+    const spawner = yield* AppProcess.Service
+    const http = yield* HttpClient.HttpClient
+    const scope = yield* Scope.Scope
+    return makeService({ config, global, fs, spawner, http, scope })
+  }),
+)
+
+export const node = LayerNode.make({
+  service: Service,
+  layer: layer,
+  deps: [Config.node, Global.node, FSUtil.node, AppProcess.node, httpClient],
+})
+
+export * as PluginInfo from "./info"
