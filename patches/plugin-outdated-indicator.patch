+
+describe("parseTags", () => {
+  test("picks newest stable and lists top versions desc", () => {
+    const out = [
+      "aaa\trefs/tags/v1.0.0",
+      "bbb\trefs/tags/v1.2.0",
+      "ccc\trefs/tags/v1.2.0^{}",
+      "ddd\trefs/tags/v1.1.0",
+      "eee\trefs/tags/v2.0.0-rc.1",
+    ].join("\n")
+    expect(parseTags(out)).toEqual({
+      latest: "1.2.0",
+      versions: ["v2.0.0-rc.1", "v1.2.0", "v1.1.0", "v1.0.0"],
+    })
+  })
+
+  test("ignores non-semver tags and non-tag refs", () => {
+    const out = ["aaa\trefs/tags/notes", "bbb\trefs/heads/main", "ccc\trefs/tags/v1.0.0"].join("\n")
+    expect(parseTags(out)).toEqual({ latest: "1.0.0", versions: ["v1.0.0"] })
+  })
+
+  test("falls back to newest when only prereleases exist", () => {
+    const out = ["aaa\trefs/tags/v1.0.0-beta.1", "bbb\trefs/tags/v1.0.0-beta.2"].join("\n")
+    expect(parseTags(out)).toEqual({ latest: "1.0.0-beta.2", versions: ["v1.0.0-beta.2", "v1.0.0-beta.1"] })
+  })
+
+  test("returns null when nothing parses", () => {
+    expect(parseTags("")).toBeNull()
+    expect(parseTags("aaa\trefs/tags/notes")).toBeNull()
+  })
+})
+
+describe("parseNpmRegistry", () => {
+  test("uses dist-tags.latest and lists versions desc", () => {
+    expect(
+      parseNpmRegistry({
+        "dist-tags": { latest: "2.0.0" },
+        versions: { "1.0.0": {}, "2.0.0": {}, "2.1.0": {} },
+      }),
+    ).toEqual({ latest: "2.0.0", versions: ["2.1.0", "2.0.0", "1.0.0"] })
+  })
+
+  test("falls back to newest stable when dist-tags missing", () => {
+    expect(parseNpmRegistry({ versions: { "1.0.0": {}, "2.0.0": {}, "2.1.0-beta.1": {} } })).toEqual({
+      latest: "2.0.0",
+      versions: ["2.1.0-beta.1", "2.0.0", "1.0.0"],
+    })
+  })
+
+  test("returns null for non-object or missing versions", () => {
+    expect(parseNpmRegistry(null)).toBeNull()
+    expect(parseNpmRegistry("nope")).toBeNull()
+    expect(parseNpmRegistry({ "dist-tags": { latest: "1.0.0" } })).toBeNull()
+    expect(parseNpmRegistry({ versions: {} })).toBeNull()
+  })
