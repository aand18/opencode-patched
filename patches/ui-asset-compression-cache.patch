-function embeddedUIResponse(file: string, body: Uint8Array) {
-  const mime = FSUtil.mimeType(file)
+// Vite content-hashes assets under assets/ (8-char [A-Za-z0-9_-] suffix, hash may
+// itself contain - or _); stable-named files (Inter.ttf,
+// JetBrainsMonoNerdFontMono-Regular.woff2, manifest, icons) must stay no-cache so
+// content updates propagate.
+function embeddedUIResponse(name: string, body: Uint8Array) {
+  const mime = FSUtil.mimeType(name)
   const headers = new Headers({ "content-type": mime })
   if (mime.startsWith("text/html")) {
     headers.set("content-security-policy", cspForHtml(new TextDecoder().decode(body)))
   }
-  return HttpServerResponse.raw(body, { headers })
+  const hashedAsset = name.startsWith("assets/") && /-[_A-Za-z0-9-]{8}\.[a-z0-9]+$/.test(name)
+  headers.set("cache-control", hashedAsset ? "public, max-age=31536000, immutable" : "no-cache")
+  // Uint8Array body (not .raw) so the compression middleware can gzip it
+  return HttpServerResponse.uint8Array(body, { headers })
 }
 
