+import { describe, expect, test } from "bun:test"
+import {
+  genericInputRows,
+  genericInputText,
+  inputCoveredByOutput,
+  isPlainRecord,
+  looksCode,
+  looksMarkdown,
+  parseJsonDocument,
+  prettyJsonDocument,
+  shouldStackValue,
+} from "./generic-tool-input"
+
+describe("genericInputRows", () => {
+  test("returns empty rows for undefined input", () => {
+    expect(genericInputRows(undefined)).toEqual([])
+  })
+
+  test("renders scalars as-is", () => {
+    expect(genericInputRows({ title: "Fix login", count: 2, active: true })).toEqual([
+      { key: "title", value: "Fix login" },
+      { key: "count", value: "2" },
+      { key: "active", value: "true" },
+    ])
+  })
+
+  test("joins primitive arrays with commas", () => {
+    expect(genericInputRows({ labels: ["bug", "auth"] })).toEqual([{ key: "labels", value: "bug, auth" }])
+  })
+
+  test("nests one level of scalar objects into subrows", () => {
+    expect(genericInputRows({ options: { depth: "advanced", retries: 3 } })).toEqual([
+      {
+        key: "options",
+        value: "",
+        subrows: [
+          { key: "depth", value: "advanced" },
+          { key: "retries", value: "3" },
+        ],
+      },
+    ])
+  })
+
+  test("skips undefined and function values", () => {
+    expect(genericInputRows({ keep: "yes", skip: undefined, fn: () => {} })).toEqual([{ key: "keep", value: "yes" }])
+  })
+
+  test("pretty-prints string values that hold JSON objects", () => {
+    expect(genericInputRows({ filter: `{"a":1,"b":[2,3]}` })).toEqual([
+      { key: "filter", value: `{\n  "a": 1,\n  "b": [\n    2,\n    3\n  ]\n}` },
+    ])
+  })
+
+  test("leaves plain strings untouched", () => {
+    expect(genericInputRows({ note: "just {text} here" })).toEqual([{ key: "note", value: "just {text} here" }])
+  })
+})
+
+describe("prettyJsonDocument", () => {
+  test("returns undefined for markdown text", () => {
+    expect(prettyJsonDocument("# Title\n\nsome **bold** text")).toBeUndefined()
+  })
+
+  test("returns undefined for empty text", () => {
+    expect(prettyJsonDocument("   ")).toBeUndefined()
+  })
+
+  test("pretty-prints JSON objects and arrays", () => {
+    expect(prettyJsonDocument(`{"a":1}`)).toBe(`{\n  "a": 1\n}`)
+    expect(prettyJsonDocument(`[1,2]`)).toBe(`[\n  1,\n  2\n]`)
+  })
+
+  test("returns undefined for malformed JSON", () => {
+    expect(prettyJsonDocument(`{"a":`)).toBeUndefined()
+  })
+})
+
+describe("looksMarkdown", () => {
+  test("detects headings, lists, fences, links, bold, and code", () => {
+    expect(looksMarkdown("# Title")).toBe(true)
+    expect(looksMarkdown("- item")).toBe(true)
+    expect(looksMarkdown("1. item")).toBe(true)
+    expect(looksMarkdown("> quote")).toBe(true)
+    expect(looksMarkdown("```js\ncode\n```")).toBe(true)
+    expect(looksMarkdown("see [docs](https://example.com)")).toBe(true)
+    expect(looksMarkdown("a **bold** move")).toBe(true)
+    expect(looksMarkdown("run `bun test`")).toBe(true)
+  })
+
+  test("leaves plain params and snake_case alone", () => {
+    expect(looksMarkdown("my_file_path")).toBe(false)
+    expect(looksMarkdown("Fix login redirect")).toBe(false)
+    expect(looksMarkdown("*.ts")).toBe(false)
+    expect(looksMarkdown("a*b")).toBe(false)
+    expect(looksMarkdown(`{"a": 1}`)).toBe(false)
+  })
+
+  test("does not treat code with # comments as markdown", () => {
+    const python = `# fetch the session\nimport json\n\ndef load(path):\n    return json.load(open(path))`
+    expect(looksCode(python)).toBe(true)
+    expect(looksMarkdown(python)).toBe(false)
+  })
+
+  test("still detects real headings without code markers", () => {
+    expect(looksMarkdown("# Release notes\n\nSome prose here")).toBe(true)
+  })
+
+  test("fenced code blocks still count as markdown", () => {
+    expect(looksMarkdown("result:\n```python\n# comment\nx = 1\n```")).toBe(true)
+  })
+})
+
+describe("parseJsonDocument + genericInputRows", () => {
+  test("formats a JSON object output like input rows", () => {
+    const parsed = parseJsonDocument(`{"title":"Fix login","labels":["bug","auth"]}`)
+    expect(isPlainRecord(parsed)).toBe(true)
+    expect(genericInputRows(parsed as Record<string, unknown>)).toEqual([
+      { key: "title", value: "Fix login" },
+      { key: "labels", value: "bug, auth" },
+    ])
+  })
+
+  test("returns undefined for markdown output", () => {
+    expect(parseJsonDocument("# Title\n\ntext")).toBeUndefined()
+  })
+})
+
+describe("shouldStackValue", () => {
+  test("stacks multi-line values under the key", () => {
+    expect(shouldStackValue("line one\nline two")).toBe(true)
+    expect(shouldStackValue(`{\n  "a": 1\n}`)).toBe(true)
+  })
+
+  test("keeps short values beside the key", () => {
+    expect(shouldStackValue("Fix login")).toBe(false)
+    expect(shouldStackValue("")).toBe(false)
+  })
+})
+
+describe("inputCoveredByOutput", () => {
+  const code = `import re, os\n\n${"x = 1\n".repeat(30)}print("done")`
+  const rows = [
+    { key: "code", value: code },
+    { key: "language", value: "python" },
+  ]
+
+  test("hides input echoed verbatim in the output", () => {
+    expect(inputCoveredByOutput(rows, `\`\`\`python\n${code}\n\`\`\`\n\ntotal segs: 10`)).toBe(true)
+  })
+
+  test("keeps input when a substantial value is missing from the output", () => {
+    expect(inputCoveredByOutput(rows, "total segs: 10")).toBe(false)
+  })
+
+  test("ignores short-only inputs", () => {
+    expect(inputCoveredByOutput([{ key: "language", value: "python" }], "```python\ncode\n```")).toBe(false)
+  })
+
+  test("matches across whitespace differences", () => {
+    expect(inputCoveredByOutput(rows, `\`\`\`python\n${code.replaceAll("\n", "  \n")}\n\`\`\``)).toBe(true)
+  })
+
+  test("returns false for empty output", () => {
+    expect(inputCoveredByOutput(rows, "   ")).toBe(false)
+  })
+})
+
+describe("genericInputText", () => {
+  test("flattens rows and subrows into readable lines", () => {
+    expect(
+      genericInputText([
+        { key: "title", value: "Fix login" },
+        {
+          key: "options",
+          value: "",
+          subrows: [{ key: "depth", value: "advanced" }],
+        },
+      ]),
+    ).toBe("title: Fix login\noptions:\n  depth: advanced")
+  })
