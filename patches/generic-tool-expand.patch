@@ -0,0 +1,153 @@
+function formatScalar(value: unknown): string | undefined {
+  if (typeof value === "string") return value
+  if (typeof value === "number" || typeof value === "boolean" || typeof value === "bigint") return String(value)
+  if (value === null) return "null"
+  return undefined
+}
+
+export function prettyJsonDocument(value: string): string | undefined {
+  const trimmed = value.trim()
+  if (!trimmed) return undefined
+  if (!trimmed.startsWith("{") && !trimmed.startsWith("[")) return undefined
+  try {
+    return JSON.stringify(JSON.parse(trimmed), null, 2)
+  } catch {
+    return undefined
+  }
+}
+
+export function parseJsonDocument(value: string): unknown {
+  const trimmed = value.trim()
+  if (!trimmed) return undefined
+  if (!trimmed.startsWith("{") && !trimmed.startsWith("[")) return undefined
+  try {
+    return JSON.parse(trimmed)
+  } catch {
+    return undefined
+  }
+}
+
+export function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) return false
+  const proto = Object.getPrototypeOf(value)
+  return proto === Object.prototype || proto === null
+}
+
+const MARKDOWN_STRUCTURAL = [
+  /^>\s+\S/m,
+  /^\s*[-*+]\s+\S/m,
+  /^\s*\d+[.)]\s+\S/m,
+  /```/,
+  /!\[[^\]]*\]\([^)]*\)/,
+  /\[[^\]]+\]\([^)]*\)/,
+]
+
+const MARKDOWN_INLINE = [/^#{1,6}\s+\S/m, /\*\*[^*\n]+\*\*/, /`[^`\n]+`/]
+
+const CODE_SIGNALS = [
+  /^\s*(import|from|def|class|return|print|const|let|var|function|if|elif|else|for|while|try|except|with|switch|case|do|package|func|fn|struct|impl|pub|echo|export)\b/m,
+  /[A-Za-z_$][\w$.]*\s*\(.*\)/,
+  /[{};]/,
+  /^\s*#include\b/m,
+  /=>|->|:=|===|!==|\|\||&&/,
+]
+
+export function looksCode(value: string): boolean {
+  if (!value.includes("\n")) return false
+  return CODE_SIGNALS.some((pattern) => pattern.test(value))
+}
+
+export function looksMarkdown(value: string): boolean {
+  if (MARKDOWN_STRUCTURAL.some((pattern) => pattern.test(value))) return true
+  if (looksCode(value)) return false
+  return MARKDOWN_INLINE.some((pattern) => pattern.test(value))
+}
+
+function formatValue(value: unknown): string | undefined {
+  if (typeof value === "string") return prettyJsonDocument(value) ?? value
+  const scalar = formatScalar(value)
+  if (scalar !== undefined) return scalar
+  if (Array.isArray(value)) {
+    if (value.length === 0) return ""
+    if (value.every((item) => formatScalar(item) !== undefined))
+      return value.map((item) => formatScalar(item) as string).join(", ")
+    try {
+      return JSON.stringify(value, null, 2)
+    } catch {
+      return undefined
+    }
+  }
+  if (isPlainRecord(value)) {
+    try {
+      return JSON.stringify(value, null, 2)
+    } catch {
+      return undefined
+    }
+  }
+  return undefined
+}
+
+export type GenericInputSubrow = { key: string; value: string }
+export type GenericInputRow = { key: string; value: string; subrows?: GenericInputSubrow[] }
+
+export function shouldStackValue(value: string): boolean {
+  return value.includes("\n")
+}
+
+const COVERED_VALUE_MIN_LENGTH = 100
+
+export function inputCoveredByOutput(rows: GenericInputRow[], output: string): boolean {
+  const normalize = (text: string) => text.replace(/\s+/g, " ")
+  const haystack = normalize(output)
+  if (!haystack.trim()) return false
+  const values = rows.flatMap((row) => [row.value, ...(row.subrows ?? []).map((sub) => sub.value)])
+  const substantial = values.filter((value) => value.trim().length >= COVERED_VALUE_MIN_LENGTH)
+  if (substantial.length === 0) return false
+  return substantial.every((value) => haystack.includes(normalize(value)))
+}
+
+export function genericInputText(rows: GenericInputRow[]): string {
+  return rows
+    .map((row) =>
+      row.subrows ? `${row.key}:\n${row.subrows.map((sub) => `  ${sub.key}: ${sub.value}`).join("\n")}` : `${row.key}: ${row.value}`,
+    )
+    .join("\n")
+}
+
+export function genericInputRows(input: Record<string, unknown> | undefined): GenericInputRow[] {
+  if (!input) return []
+  const rows: GenericInputRow[] = []
+  for (const [key, value] of Object.entries(input)) {
+    if (value === undefined) continue
+    if (typeof value === "function" || typeof value === "symbol") continue
+    if (isPlainRecord(value)) {
+      const entries = Object.entries(value).filter(
+        ([, nested]) => nested !== undefined && typeof nested !== "function" && typeof nested !== "symbol",
+      )
+      if (
+        entries.length > 0 &&
+        entries.every(
+          ([, nested]) =>
+            formatScalar(nested) !== undefined ||
+            (Array.isArray(nested) && nested.every((item) => formatScalar(item) !== undefined)),
+        )
+      ) {
+        rows.push({
+          key,
+          value: "",
+          subrows: entries.map(([nestedKey, nested]) => ({
+            key: nestedKey,
+            value: Array.isArray(nested)
+              ? (nested as unknown[]).map((item) => formatScalar(item) as string).join(", ")
+              : (formatScalar(nested) as string),
+          })),
+        })
+        continue
+      }
+    }
+    const formatted = formatValue(value)
+    if (formatted === undefined) continue
+    rows.push({ key, value: formatted })
+  }
+  return rows
+}
