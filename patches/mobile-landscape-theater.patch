+/* Short-landscape theater mode (phones held sideways: short viewport, touch
+   as the primary input).
+   UNLAYERED on purpose: these display rules must beat Tailwind's `flex`
+   utilities, which live in `@layer utilities` and would otherwise win over
+   anything in `@layer components` regardless of specificity.
+   Hides the whole titlebar, mobile session tabs, and composer dock so the
+   timeline owns the viewport. Fullscreen is pushed from titlebar.tsx and
+   exited only via the browser's own affordance.
+   The pointer guard (not a width guard) keeps zoomed desktop windows out:
+   pinch/page zoom changes CSS px but never the primary input method. */
+@media (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
+  [data-component="titlebar"] {
+    display: none;
+  }
+
+  #opencode-titlebar-center {
+    display: none;
+  }
+
+  [data-component="session-mobile-tabs"] {
+    display: none;
+  }
+
+  [data-component="session-prompt-dock"] {
+    display: none;
+  }
+}
