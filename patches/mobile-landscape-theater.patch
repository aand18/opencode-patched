+const shortLandscapeQuery = "(orientation: landscape) and (max-height: 500px) and (pointer: coarse)"
+
+// Theater mode: short landscape is always fullscreen with the titlebar,
+// mobile tabs, and composer hidden (see index.css). The entry attempt only
+// succeeds with a live user gesture, so a pending entry is also captured on
+// the next interaction: rotating then tapping anywhere lands in fullscreen,
+// including after a reload in landscape. Fullscreen is never exited
+// programmatically: rotating back to portrait keeps it (the CSS hiding lifts
+// on its own) and the browser's own exit affordance is the way out.
+// Automatic pushes are touch-devices only so zoomed desktop windows are left
+// alone. iPhones lack the API entirely; there the CSS hiding is the win.
+function useAutoLandscapeFullscreen() {
+  const shortLandscape = createMediaQuery(shortLandscapeQuery)
+  const coarse = createMediaQuery("(pointer: coarse)")
+  let want = false
+  const enter = () => {
+    if (typeof document === "undefined" || document.fullscreenElement) return
+    void document.documentElement.requestFullscreen({ navigationUI: "hide" }).catch(() => {})
+  }
+  onMount(() => {
+    const onFsExit = () => {
+      // An exit while still in landscape keeps the next tap armed so
+      // landscape stays fullscreen; only leaving landscape disarms.
+      if (!document.fullscreenElement && !shortLandscape()) want = false
+    }
+    // First interaction after entering landscape carries the gesture the
+    // immediate attempt was missing. Capture phase + every gesture type so
+    // this runs no matter what the app does with the event.
+    const onInteract = () => {
+      if (want) enter()
+    }
+    const capture: AddEventListenerOptions = { capture: true, passive: true }
+    document.addEventListener("fullscreenchange", onFsExit)
+    document.addEventListener("pointerdown", onInteract, capture)
+    document.addEventListener("touchstart", onInteract, capture)
+    document.addEventListener("click", onInteract, capture)
+    document.addEventListener("keydown", onInteract, capture)
+    onCleanup(() => {
+      document.removeEventListener("fullscreenchange", onFsExit)
+      document.removeEventListener("pointerdown", onInteract, capture)
+      document.removeEventListener("touchstart", onInteract, capture)
+      document.removeEventListener("click", onInteract, capture)
+      document.removeEventListener("keydown", onInteract, capture)
+    })
+  })
+  createEffect(() => {
+    if (typeof document === "undefined") return
+    if (shortLandscape() && coarse()) {
+      want = true
+      enter()
+    } else {
+      want = false
+    }
+  })
+}
+
+// Once-per-load hint for the landscape fullscreen gesture. Visible only
+// while it can still teach something: short landscape, touch input, the API
+// present, not yet tapped, not currently fullscreen. The first landscape tap
+// or the first fullscreen entry dismisses it until the next reload; taps pass
+// through the pill so the same tap also triggers the entry.
+function useLandscapeFsHint() {
+  const shortLandscape = createMediaQuery(shortLandscapeQuery)
+  const coarse = createMediaQuery("(pointer: coarse)")
