+describe("heic downscale", () => {
+  test("downscales converted images larger than the model limit", async () => {
+    setHeicConverterForTests(async () => new Blob(["jpeg"], { type: "image/jpeg" }))
+    const previousBitmap = (globalThis as Record<string, unknown>).createImageBitmap
+    const previousDocument = (globalThis as Record<string, unknown>).document
+    const downsized = new Blob(["small"], { type: "image/jpeg" })
+    const drawn: string[] = []
+    let encodeQuality: number | undefined
+    ;(globalThis as Record<string, unknown>).createImageBitmap = async () => ({
+      width: 4000,
+      height: 3000,
+      close: () => undefined,
+    })
+    ;(globalThis as Record<string, unknown>).document = {
+      createElement: () => ({
+        width: 0,
+        height: 0,
+        getContext: () => ({
+          drawImage: () => {
+            drawn.push("drawImage")
+          },
+          set imageSmoothingEnabled(value: boolean) {
+            drawn.push(`smoothingEnabled=${value}`)
+          },
+          set imageSmoothingQuality(value: string) {
+            drawn.push(`smoothingQuality=${value}`)
+          },
+        }),
+        toBlob: (callback: (blob: Blob | null) => void, _type?: string, quality?: number) => {
+          encodeQuality = quality
+          callback(downsized)
+        },
+      }),
+    }
+    try {
+      const converted = await convertHeicToJpeg(new File(["heic"], "big.heic", { type: "image/heic" }))
+      expect(converted.type).toBe("image/jpeg")
+      expect(converted.name).toBe("big.jpg")
+      expect(await converted.text()).toBe("small")
+      expect(drawn).toContain("smoothingEnabled=true")
+      expect(drawn).toContain("smoothingQuality=high")
+      expect(encodeQuality).toBeGreaterThanOrEqual(0.95)
+    } finally {
+      if (previousBitmap === undefined) delete (globalThis as Record<string, unknown>).createImageBitmap
+      else (globalThis as Record<string, unknown>).createImageBitmap = previousBitmap
+      if (previousDocument === undefined) delete (globalThis as Record<string, unknown>).document
+      else (globalThis as Record<string, unknown>).document = previousDocument
+      setHeicConverterForTests(undefined)
+    }
+  })
