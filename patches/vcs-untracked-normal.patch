index 968e394a9..09fef7144 100644
--- a/packages/opencode/src/git/index.ts
+++ b/packages/opencode/src/git/index.ts
@@ -212,14 +212,25 @@ const layer = Layer.effect(
       return result.text()
     })
 
+    // --- Respect .gitignore for untracked files (upstream anomalyco/opencode#33928, #21699, #3176) ---
+    //
+    // `--untracked-files=all` enumerates every individual file inside untracked directories,
+    // including those in .gitignore'd directories like node_modules/. This causes:
+    // - 200%+ CPU saturation from thousands of sequential git subprocesses (#21699)
+    // - VCS crash on repos with 1200+ untracked files (#33928)
+    // - 8.7 min response times on large repos (#3176)
+    //
+    // `--untracked-files=normal` (git's default since 1.7.0) collapses untracked directories
+    // into single entries (?? dir/). Directory entries are filtered out below - patchUntracked()
+    // and statUntracked() can't operate on directories anyway.
     const status = Effect.fn("Git.status")(function* (cwd: string) {
       return nuls(
-        yield* text(["status", "--porcelain=v1", "--untracked-files=all", "--no-renames", "-z", "--", "."], {
+        yield* text(["status", "--porcelain=v1", "--untracked-files=normal", "--no-renames", "-z", "--", "."], {
           cwd,
         }),
       ).flatMap((item) => {
         const file = item.slice(3)
-        if (!file) return []
+        if (!file || file.endsWith("/")) return []  // skip directory entries from --untracked-files=normal
         const code = item.slice(0, 2)
         return [{ file, code, status: kind(code) } satisfies Item]
       })
